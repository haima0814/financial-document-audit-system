# ==============================================================================
# 财务单据智能风险审核系统 - 环境变量配置模版 (.env.example)
# 使用说明：复制此文件为 .env 并根据实际环境调整配置即可
# ==============================================================================

# 项目基础配置
PROJECT_NAME="财务单据智能风险审核系统"
API_V1_STR="/api/v1"

# 运行模式：
# - local: 本地轻量极速模式 (SQLite + asyncio 异步任务管理器，无需外部依赖)
# - production: 生产高可用模式 (PostgreSQL + Redis + Celery 分布式任务队列)
RUN_MODE=local

# 数据库连接字符串：
# 1. 本地轻量开发 (默认)：
DATABASE_URL=sqlite+aiosqlite:///./financial_audit.db
# 2. 生产环境 PostgreSQL 示例：
# DATABASE_URL=postgresql+asyncpg://postgres:YourPassword123@localhost:5432/financial_audit

# Redis 缓存与 Celery Broker 连接 (生产模式下使用)
REDIS_URL=redis://localhost:6379/0

# JWT 安全密钥与令牌有效期 (单位：分钟)
SECRET_KEY=dev-secret-key-financial-risk-audit-2026-super-secure
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 跨域 CORS 允许白名单 (逗号分隔或 JSON 列表格式)
CORS_ORIGINS=["*"]

# ==============================================================================
# 大模型 (LLM) 接入配置 (兼容标准 OpenAI 协议)
# 支持 DeepSeek, Qwen (通义千问), Moonshot (Kimi), Gemini, OpenAI 等
# 若保持默认 "mock-key"，系统将启用企业内控规则模板与降级兜底算法，100% 离线稳定可用
# ==============================================================================
OPENAI_API_KEY=mock-key
OPENAI_BASE_URL=https://api.deepseek.com/v1
DEFAULT_LLM_MODEL=deepseek-chat
